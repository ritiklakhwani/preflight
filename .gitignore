.env
.env.*
!.env.example
node_modules
.pgdata
dist
.next
*.tsbuildinfo
.DS_Store

# Credentials encrypted against the Ledger Key Ring are committed on purpose:
# they are ciphertext and the repo is the distribution mechanism. Plaintext
# never is.
secrets/*
!secrets/*.enc
!secrets/README.md

# Foundry build output. contracts/broadcast stays committed: it is the
# deployment record judges can check.
contracts/out
contracts/cache

# forge dry-run simulations
contracts/broadcast/**/dry-run/
