# The Graph - API key from https://thegraph.com/studio
GRAPH_API_KEY=

# Subgraph IDs. Screen candidates first:
#   node --env-file=.env --import tsx scripts/probe-subgraph.ts <id>
# Uniswap V3 Ethereum (official, live) - primary liquidity source
SG_UNISWAP_V3=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
# Optional second DEX on Ethereum for cross-protocol comparison
SG_SUSHISWAP=
SG_BALANCER=

# Etherscan - https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# LLM - provide at least one of the two below
# Anthropic - https://console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Hedera testnet - https://portal.hedera.com
HEDERA_ACCOUNT_ID=
HEDERA_PRIVATE_KEY=
HEDERA_TOPIC_ID=

# Local
DATABASE_URL=postgres://postgres:preflight@localhost:5432/preflight
GATE_URL=http://localhost:8787
LEDGER_ACCOUNT_LABEL=ethereum-1

# LLM provider: anthropic | openai. Omit to auto-pick whichever key is present.
LLM_PROVIDER=
# Optional model overrides
ANTHROPIC_MODEL=
OPENAI_MODEL=
