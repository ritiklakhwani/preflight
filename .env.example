# The Graph - API key from https://thegraph.com/studio
GRAPH_API_KEY=

# Uniswap V3 subgraph deployment ids. Defaults are compiled into
# packages/signals/src/graph.ts, so these are overrides, not requirements.
# Screen any replacement first, since several live subgraphs are labelled
# "Uniswap V3" but use the Messari schema and will fail our queries:
#   node --env-file=.env --import tsx scripts/probe-subgraph.ts <id>
SG_UNISWAP_V3_ETHEREUM=
SG_UNISWAP_V3_ARBITRUM=
SG_UNISWAP_V3_BASE=

# Etherscan V2, one key covers every chain
# https://etherscan.io/apis
ETHERSCAN_API_KEY=

# One of these enables the advisory model summary. Without either, the
# deterministic verdict still stands.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai. Defaults to whichever key is present.
LLM_PROVIDER=
ANTHROPIC_MODEL=
OPENAI_MODEL=

# Optional. Without it verdicts live in memory for the life of the process.
DATABASE_URL=postgres://postgres:preflight@localhost:5432/preflight

# Ledger confirmation service, once packages/gate exists
GATE_URL=http://localhost:8787
LEDGER_ACCOUNT_LABEL=ethereum-1
