# The Graph - API key from https://thegraph.com/studio
GRAPH_API_KEY=

# Uniswap V3 subgraph deployment ids. Defaults are compiled into
# packages/signals/src/graph.ts, so these are overrides, not requirements.
# Screen any replacement first, since several live subgraphs are labelled
# "Uniswap V3" but use the Messari schema and will fail our queries:
#   node --env-file=.env --import tsx scripts/probe-subgraph.ts <id>
SG_UNISWAP_V3_ETHEREUM=
SG_UNISWAP_V3_ARBITRUM=
SG_UNISWAP_V3_BASE=

# Etherscan V2, one key covers every chain
# https://etherscan.io/apis
ETHERSCAN_API_KEY=

# One of these enables the advisory model summary. Without either, the
# deterministic verdict still stands.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai. Defaults to whichever key is present.
LLM_PROVIDER=
ANTHROPIC_MODEL=
OPENAI_MODEL=

# Optional. Without it verdicts live in memory for the life of the process.
DATABASE_URL=postgres://postgres:preflight@localhost:5432/preflight

# Ledger. Credentials above are read from secrets/*.enc when those files exist,
# which is the point of the Key Ring integration; these stay here as a fallback.
# The account label is the one `wallet-cli session view` reports.
LEDGER_ACCOUNT_LABEL=ethereum-1
# Optional. Absolute path to wallet-cli, if it is not on PATH.
WALLET_CLI_PATH=
# Set to off to run without a device. The verdict records that nobody approved it.
PREFLIGHT_GATE=
# How long someone has to press, once a device is known to be attached. Default 40000.
GATE_TIMEOUT_MS=
# Set to skip the USB presence check and let wallet-cli discover the device itself.
PREFLIGHT_SKIP_USB_PROBE=

# ---------------------------------------------------------------------------
# ETHGlobal Mumbai 2026: Capline
# ---------------------------------------------------------------------------
# Whitechain Sepolia, chain 1874. Faucet gives WBT only (gas); test USDT is
# minted by Whitechain, ask at the booth.
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
WHITECHAIN_USDT=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
# Base mainnet, for the Flash trading agent. Flash has no testnet.
BASE_RPC_URL=
# Deploys CaplineVault. Use a fresh key.
DEPLOYER_PRIVATE_KEY=
# Agent hot wallets. Each only ever holds one tranche.
PAYER_AGENT_PRIVATE_KEY=
TRADER_AGENT_PRIVATE_KEY=
# Definitive Flash API key (app.definitive.fi > More > Flash > Create Flash Key)
DEFINITIVE_API_KEY=
# Pocket Approve push channel. Only request ids are sent over it.
NTFY_TOPIC=
# Filled in after deployment
CAPLINE_VAULT_WHITECHAIN=
CAPLINE_VAULT_BASE=
# Submits owner-signed releases and drops. Any funded key works; falls back to
# DEPLOYER_PRIVATE_KEY.
RELAYER_PRIVATE_KEY=
# Pocket Approve server and the public HTTPS URL of the phone app
APPROVE_PORT=8787
APPROVE_PUBLIC_URL=
CAPLINE_API_URL=http://localhost:8787
# Agent wallet the MCP tools act for (address, not key)
CAPLINE_AGENT_ADDRESS=
# Merchant pay-per-call API (Whitechain USDT)
MERCHANT_PORT=8788
MERCHANT_PAYTO=
MERCHANT_EVIL=
PARTNER_ADDRESS=
# Paying agent in LLM mode
ANTHROPIC_API_KEY=
CAPLINE_AGENT_MODEL=claude-sonnet-5-5
