#!/usr/bin/env bash
#
# Launcher for the Preflight MCP server.
#
# MCP clients are GUI applications. They do not inherit a login shell, so `node`
# is usually absent from their PATH, and the working directory they spawn a
# server in is not the repository. Both of those break the obvious
# `node --import tsx ...` invocation in a way that surfaces only as a server
# that silently fails to start.
#
# This script resolves the interpreter and the repository root itself, so the
# client config needs nothing but a path to this file.
#
# Override the interpreter with PREFLIGHT_NODE if you need a specific one.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

NODE="${PREFLIGHT_NODE:-$(command -v node || true)}"
if [ -z "$NODE" ]; then
  for candidate in "$HOME"/.nvm/versions/node/*/bin/node /opt/homebrew/bin/node /usr/local/bin/node; do
    if [ -x "$candidate" ]; then NODE="$candidate"; break; fi
  done
fi
if [ -z "$NODE" ]; then
  echo "preflight-mcp: no node interpreter found. Set PREFLIGHT_NODE to its path." >&2
  exit 127
fi

# wallet-cli needs a passphrase for Key Ring operations and refuses to prompt
# without a TTY, which an MCP server spawned by a GUI client never has. Its own
# error message recommends injecting it from the OS keychain, so that is what
# this does. The passphrase never touches a file or the client config.
#
# Absent keychain entry is not fatal: the device confirmation does not need it,
# only the encrypted credential store does, and that reports its own failure.
if [ -z "${WALLET_PASS:-}" ]; then
  case "$(uname -s)" in
    Darwin)
      WALLET_PASS="$(security find-generic-password -a default -s ledger-wallet-cli -w 2>/dev/null || true)"
      ;;
    Linux)
      WALLET_PASS="$(secret-tool lookup service ledger-wallet-cli account default 2>/dev/null || true)"
      ;;
  esac
  [ -n "$WALLET_PASS" ] && export WALLET_PASS
fi

if [ ! -f "$ROOT/.env" ]; then
  echo "preflight-mcp: $ROOT/.env is missing. Copy .env.example and fill in the keys." >&2
  exit 1
fi

# cd so that `--import tsx` resolves against the repository's node_modules.
cd "$ROOT"
exec "$NODE" --env-file="$ROOT/.env" --import tsx "$ROOT/packages/mcp/src/index.ts" "$@"
